{
  "paths": {
    "credentials": "systemdata/credentials.json",
    "token": "systemdata/token.json",
    "state": "data/poller_state.json",
    "database": "data/jobs.db",
    "classifier_log": "data/classifier_log.jsonl",
    "resume": "data/resume.txt",
    "job_descriptions": "data/job_descriptions.json",
    "experience_bank": "data/experience_bank.json"
  },
  "gmail": {
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"],
    "inbox_query": "in:inbox",
    "skip_labels": ["CATEGORY_SOCIAL", "CATEGORY_FORUMS"],
    "max_body_chars": 8000
  },
  "poller": {
    "interval_seconds": 120,
    "backfill_days": 14
  },
  "model": {
    "backend": "ollama",
    "timeout_seconds": 180,

    "endpoints": {
      "ollama": "http://localhost:11434"
    },

    "models": {
      "default": "qwen3:4b"
    }
  },
  "classifier": {
    "min_confidence": 0.6,
    "input_body_chars": 1500
  },
  "extractor": {
    "body_chars": 4000,
    "max_links": 40,
    "resolve_links": true
  },
  "jd": {
    "fetch_timeout_seconds": 15,
    "min_chars": 300,
    "max_chars": 20000,
    "model_input_chars": 8000,
    "structure_with_model": true
  },
  "builder": {
    "output_dir": "output",
    "font_sizes": [10.5, 10, 9.5, 9],
    "num_ctx": 8192
  },
  "dashboard": {
    "port": 3000,
    "python": "python"
  }
}